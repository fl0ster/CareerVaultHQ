# Copy to .env and adjust. All values are optional; defaults are shown.
APP_NAME=CareerVaultHQ
DEBUG=false
HOST=0.0.0.0
PORT=8000
# Comma-separated origins allowed by CORS (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Path to the built frontend (relative to the backend/ folder or absolute)
FRONTEND_DIST=../frontend/dist
# Redis used by the job queue (docker-compose: redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0
# Folder for uploaded .tex files and generated PDFs; shared by API and worker
LATEX_UPLOAD_ROOT=static/uploads
LATEX_JOBS_ROOT=static/jobs
# LaTeX compiler binary, number of passes and per-job timeout (seconds)
LATEX_COMPILER=pdflatex
LATEX_PASSES=2
LATEX_TIMEOUT=300
# CV generation: output folder (<CV_ROOT>/<id>/cv.pdf), chat model override (empty = the
# default chat model), concurrent OpenRouter requests per generation and the job timeout
CV_ROOT=static/cv
CV_CHAT_MODEL=
CV_MAX_WORKERS=4
CV_TIMEOUT=1800
# Timeline rules: roles listed in full, relevance thresholds and the minimum gap (months)
CV_MAX_ENTRIES=5
CV_HIGH_RELEVANCE=0.3
CV_EXCEPTIONAL_RELEVANCE=0.6
CV_IRRELEVANT_RELEVANCE=0.1
CV_MIN_MONTHS=3
# CV import from PDF: upload dir, upload size limit (bytes), text limits and chat model
# (empty = OPENROUTER_CHAT_MODEL). PDFs need a text layer; scans are rejected.
# CV_IMPORT_UPLOAD_ROOT=static/cv_import
# CV_IMPORT_MAX_UPLOAD_BYTES=10485760
# CV_IMPORT_MAX_PAGES=10
# CV_IMPORT_MAX_CHARS=60000
# CV_IMPORT_MIN_TEXT_CHARS=200
# CV_IMPORT_MODEL=
# OpenRouter (LLM calls). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default models for free-text chat and structured "decision" calls
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_DECISION_MODEL=typesafe/jev-1.14
OPENROUTER_TIMEOUT=120
# Optional attribution headers (HTTP-Referer / X-Title)
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=CareerVaultHQ
# How often to run scheduler
SCHEDULER_TICK_FREQUENCY_SECONDS=
RELEVANT_JOB_THRESHOLD=0.6