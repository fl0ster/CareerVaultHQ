    "typographyMeta": {
      "display": {
        "displayName": "Display",
        "purpose": "Stat-tile numerals."
      },
      "headline": {
        "displayName": "Headline",
        "purpose": "Page h1; 30px below 900px."
      },
      "title": {
        "displayName": "Title",
        "purpose": "Section h2."
      },
      "wordmark": {
        "displayName": "Wordmark",
        "purpose": "The Pica wordmark; the profile name uses the face at 19px/760."
      },
      "subtitle": {
        "displayName": "Subtitle",
        "purpose": "h3 and row titles."
      },
      "body": {
        "displayName": "Body",
        "purpose": "Default text."
      },
      "control": {
        "displayName": "Control",
        "purpose": "Buttons, inputs, nav items."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Stat labels, segmented tabs, meta."
      },
      "counter": {
        "displayName": "Counter",
        "purpose": "Nav counters, tabular."
      },
      "mono": {
        "displayName": "Mono",
        "purpose": "Inline code."
      }
    },
    "themes": {
      "light": {
        "name": "Sunrise",
        "selector": ":root"
      },
      "dark": {
        "name": "Sunset",
        "selector": "@media (prefers-color-scheme: dark) :root:not([data-theme='light']), :root[data-theme='dark']"
      }
    },
    "shadows": [
      {
        "name": "shadow-sm / shadow-md / shadow-lg / shadow",
        "value": "none",
        "purpose": "Flat by rule: no elevation shadows. Depth comes from tone steps."
      },
      {
        "name": "focus-ring",
        "value": "0 0 0 3px rgba(58, 79, 200, 0.3)",
        "purpose": "Focus ring on controls (Sunset: rgba(151, 170, 255, 0.4))."
      },
      {
        "name": "current-ring",
        "value": "0 0 0 2px var(--surface), 0 0 0 4px var(--accent)",
        "purpose": "Avatar ring on the current page."
      }
    ],
    "motion": [
      {
        "name": "ease-out",
        "value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "purpose": "Default easing for state, panel and dialog transitions."
      },
      {
        "name": "ease-spring",
        "value": "cubic-bezier(0.34, 1.4, 0.64, 1)",
        "purpose": "Counter pop-in, magpie peek."
